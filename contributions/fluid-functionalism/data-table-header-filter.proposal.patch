+/** The existing sort header plus an opt-in filter action. No change at
+ *  existing callsites; sort state still belongs to the TanStack column. */
+function DataTableColumnHeader<TData, TValue>({
+  filter,
+  ...props
+}: DataTableColumnHeaderProps<TData, TValue>) {
+  "use no memo";
+  const icons = useIcons();
+  const FilterIcon = icons["sliders-horizontal"];
+  if (!filter) return <DataTableSortHeader {...props} />;
+  return (
+    <span className="inline-flex items-center gap-1 align-top">
+      <DataTableSortHeader {...props} />
+      <DropdownMenu>
+        <DropdownTrigger render={
+          <Button
+            type="button"
+            variant="ghost"
+            size="icon-compact"
+            active={filter.active}
+            aria-label={filter.label ?? `Filter ${props.title.toLowerCase()}`}
+          >
+            <FilterIcon />
+          </Button>
+        } />
+        {filter.content}
+      </DropdownMenu>
+    </span>
   );
